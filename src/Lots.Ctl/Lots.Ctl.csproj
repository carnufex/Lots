<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>lotsctl</ToolCommandName>
    <AssemblyName>lotsctl</AssemblyName>
    <RootNamespace>Lots.Ctl</RootNamespace>
    <Description>Validate, diff, apply and export Lots configuration (profiles, knowledge sources) as code.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same EF version the shell resolves, so its assembly loads (the shell's provider pulls an older one transitively). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shell's own parser: offline validation is exactly what the server will accept. -->
    <ProjectReference Include="..\Lots.Shell\Lots.Shell.csproj" />
  </ItemGroup>

</Project>
